{
  "name": "booking-prototipo-plantilla",
  "version": "1.0.0",
  "description": "Plantilla base para el sistema de Booking Prototipo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "docs:openapi": "nest build && node dist/scripts/generar-openapi.js",
    "contract:check": "node scripts/contract-check.js",
    "contract:export": "node scripts/exportar-contrato-propio.js",
    "contract:split": "node scripts/dividir-contratos.js",
    "gateway:generar": "node ../gateway/generar-kong.js",
    "gateway:check": "node ../gateway/generar-kong.js --check",
    "pact:verificar": "node scripts/verificar-pact.cjs",
    "test:roles": "node scripts/prueba-rol-servicio.cjs",
    "token:servicio": "node scripts/token-servicio.js",
    "stock:cargar": "nest build && node dist/scripts/cargar-stock.js",
    "stock:falso": "node scripts/servidor-stock-falso.cjs",
    "test:v2": "node scripts/prueba-v2.cjs",
    "test": "jest"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^8.3.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@pact-foundation/pact": "^13.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testEnvironment": "node"
  }
}
