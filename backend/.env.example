# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.

# Elige UNA de las dos opciones. El backend usa SSL solo cuando el host NO es localhost/127.0.0.1.
#
# Opción A — Postgres local con Docker (docker compose up -d en la raíz del proyecto). Sin SSL.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_db
#
# Opción B — Supabase -> Connect -> "Session pooler" o "Transaction pooler" (IPv4). SSL obligatorio.
# Formato: postgresql://postgres.<ref>:<CLAVE>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# development | production  (en production: HSTS, redirección a HTTPS y no se muestra el enlace simulado de recuperación)
APP_ENV=development
NODE_ENV=development
PORT=3000
# Interfaz donde escucha el servidor. 0.0.0.0 = acepta conexiones de otras maquinas (Tailscale). 127.0.0.1 = solo esta maquina.
HOST=0.0.0.0

# Secreto HS256 de al menos 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Orígenes permitidos (URL exacta del frontend, separadas por comas; nunca '*')
CORS_ORIGINS=http://localhost:4200

# URL pública del frontend (enlaces de alojamientos y del correo simulado de recuperación)
PUBLIC_WEB_URL=http://localhost:4200
# URL pública del backend (enlaces HATEOAS _links de las órdenes).
# En la prueba local con Booking: http://<tu IP de Tailscale 100.x.x.x>:3000
API_PUBLIC_URL=http://localhost:3000

# Fecha prevista de baja de la versión v1 (cabecera X-API-Deprecation-Date)
API_DEPRECATION_DATE=2027-12-31

# false = no correr los jobs programados (útil al probar contra datos reales)
JOBS_ENABLED=true

# --- Reto 2: stock por gRPC hacia Booking (contrato v2, sección 5). Vacío = desactivado ---
# Dirección de la ingesta de stock de Booking (IP de Tailscale de Booking + puerto), sin TLS en la prueba local.
# Aviso de stock a Booking. Canal REST (preferido): URL base de Booking y la X-API-Key que ellos entreguen.
#   STOCK_REST_URL=https://booking-core-api.azurewebsites.net   -> POST /api/v3/inventory/stock
STOCK_REST_URL=
STOCK_REST_API_KEY=
# Canal gRPC (alternativo, solo si STOCK_REST_URL está vacío)
STOCK_GRPC_TARGET=
# Identificador de este nodo en los mensajes (el código que asigne Booking; por defecto "alojamientos").
STOCK_SERVICE_ID=alojamientos

# --- Reto 2: X-API-Key del ESB de Booking (ApiKeyAuth del contrato v2, deprecada hasta v3) ---
# Mínimo 24 caracteres. Genera una con:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Vacía = la llave queda desactivada (solo Bearer). Solo vale en /api/v2 y sin permisos de check-in ni admin.
SERVICE_API_KEY=
